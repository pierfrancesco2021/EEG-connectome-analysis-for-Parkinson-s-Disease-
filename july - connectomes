    "channel_order = channel  # Your channel list\n",
    "pd_matrix = create_group_connectivity_matrix(graph_pd, channel_order)\n",
    "hc_matrix = create_group_connectivity_matrix(graph_hc, channel_order)\n",
    "\n",
    "# Plot heatmaps\n",
